# Copy to .env and fill in. NONE of these are required for Plane B (graded rank.py),
# which runs offline with zero keys. They only affect Plane A pre-compute quality
# and Plane C (live product) features.

# --- LLM backend selection for Plane A re-rank / reasoning ---
# One of: nvidia | claude_cli | deterministic   (auto-detected if unset)
LLM_BACKEND=

# --- NVIDIA NIM (build.nvidia.com) — optional; enables nv-embedqa + Nemotron re-rank ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_CHAT_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# --- Local embedding fallback (no key needed) ---
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- GCP (Plane C deploy only; not needed to build/test) ---
GCP_PROJECT=
GCP_REGION=asia-south1
