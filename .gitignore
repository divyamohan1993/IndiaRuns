# ---- Real data (465 MB) — NEVER commit ----
candidates.jsonl
data/candidates.jsonl
**/candidates.jsonl

# ---- Large binary artifacts (regenerated by precompute/ or shipped via LFS/release) ----
*.npy
*.npz
*.parquet
*.pkl
artifacts/cand_emb.f16.npy
artifacts/cand_features.f16.npy
artifacts/cand_svd32.f16.npy

# ---- Large FULL-pool text artifacts (regenerable; only the small JSONs + the sample
#      dir are committed). These are the 100K-scale row maps / per-row outputs. ----
artifacts/candidate_index.json
artifacts/reasoning.jsonl
artifacts/llm_scores.json

# Sample-sized artifacts produced during testing live in artifacts_sample/ and ARE
# committed selectively (small JSON/text + the sample .npy/.npz which are tiny);
# the *.npy/*.npz ignore above is overridden for that dir below.
!artifacts_sample/
!artifacts_sample/*.npy
!artifacts_sample/*.npz
!artifacts_sample/*.pkl
!artifacts_sample/*.parquet

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# ---- Node / web ----
node_modules/
web/.next/
web/out/
.turbo/

# ---- Env / secrets ----
.env
.env.local
*.key

# ---- OS / editor ----
.DS_Store
*.swp

# environment-specific build CA (sandbox CI only; never committed).
# The docker/ca/ directory itself is tracked (via .gitkeep) so the optional-CA
# COPY in the Dockerfiles always has an existing source dir; only the cert is ignored.
docker/ca/build-ca.crt
docker/build-ca.crt
